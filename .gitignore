# Local credentials
*kaggle*.json
.env
.env.*

# Downloaded data and large generated artifacts
data/
artifacts/**

# Keep reports and small experiment metadata reproducible on GitHub.
!artifacts/**/
!artifacts/**/*.md
!artifacts/**/*.html
!artifacts/**/*.json
!artifacts/figures/*.png
!artifacts/tables/*.csv

# Per-notebook runtime exports and isolated verification intermediates
artifacts/notebook_runs/

__pycache__/
*.py[cod]
.ipynb_checkpoints/
.venv/

# Public experiment receipts can mention Kaggle without containing credentials.
!insight/faris/**/kaggle*.json
!insight/faris/**/*kaggle*.json

# Case-level evidence and fitted models remain private.
insight/faris/**/*.npz
insight/faris/**/*.npy
insight/faris/**/*.parquet
insight/faris/**/*.joblib
insight/faris/**/*.pkl
insight/faris/**/*.pt
insight/faris/**/*.pth
insight/faris/**/*.ckpt
insight/faris/**/*.safetensors
insight/faris/**/__pycache__/
